# Copie para .streamlit/secrets.toml (local) ou cole em "Secrets" no Streamlit Cloud.
# Todas as chaves são OPCIONAIS: por padrão o app descobre as URLs via API CKAN da ANEEL.

# Fixar a URL de um recurso CSV caso a descoberta automática falhe:
# HIDRORADAR_SIGA_CSV_URL = "https://dadosabertos.aneel.gov.br/dataset/.../siga-empreendimentos-geracao.csv"
# HIDRORADAR_HIDRO_CSV_URL = "https://dadosabertos.aneel.gov.br/dataset/.../aproveitamentos-hidreletricos.csv"
# HIDRORADAR_AGENTES_CSV_URL = "https://dadosabertos.aneel.gov.br/dataset/.../agentes-geracao.csv"

# Ignorar a rede e usar apenas data/snapshots/ (ou a amostra de demonstração):
# HIDRORADAR_OFFLINE = "1"
